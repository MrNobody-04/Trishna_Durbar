# =============================================================================
# TRISHNA DURBAR RESTAURANT & BAR — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# For local development with SQLite:
# DATABASE_URL="file:./dev.db"

# For production deployment with Supabase PostgreSQL:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DATABASE_URL="file:./dev.db"

# 256-bit Random Secret Key for JWT Authentication Session Signing:
AUTH_SECRET="your-secure-random-auth-secret-min-32-chars"

# Public Application URL (used for QR routing and callbacks):
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
