# =============================================================================
# TRISHNA DURBAR RESTAURANT & BAR — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# For cloud production with Neon Serverless PostgreSQL:
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/neondb?sslmode=require"
# (Or pooled): DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT]-pooler.neon.tech/neondb?sslmode=require"

# For local offline development with SQLite (switch via: npm run db:sqlite):
# DATABASE_URL="file:./dev.db"
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 256-bit Random Secret Key for JWT Authentication Session Signing:
AUTH_SECRET="your-secure-random-auth-secret-min-32-chars"

# Public Application URL (used for QR routing and callbacks):
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# Optional Initial Administrative Account Credentials for Database Seeding:
INITIAL_OWNER_EMAIL="owner@trishnadurbar.com"
INITIAL_OWNER_PASSWORD="CreateAStrongPassword123!"
INITIAL_MANAGER_EMAIL="manager@trishnadurbar.com"
INITIAL_MANAGER_PASSWORD="CreateAStrongPassword123!"
